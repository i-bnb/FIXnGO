# ==============================================================================
# FIELDOPS TECHNICAL SERVICES LLC (DUBAI, UAE) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & POSTGIS (GEOSPATIAL SPATIAL ENGINE)
# ------------------------------------------------------------------------------
# Standard local Docker Compose PostgreSQL + PostGIS instance:
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/fieldops_db?schema=public"

# ------------------------------------------------------------------------------
# 2. CACHING & REAL-TIME QUEUE (REDIS / BULLMQ)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. BACKEND API SERVER & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV="development"
JWT_SECRET="fieldops-jwt-super-secret-key-2026-demo"
JWT_REFRESH_SECRET="fieldops-jwt-refresh-secret-key-2026-demo"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 4. BILLING & PAYMENT GATEWAY (STRIPE TEST MODE / UAE GATEWAYS)
# ------------------------------------------------------------------------------
# Options: 'STRIPE' | 'MOCK'
PAYMENT_PROVIDER="STRIPE"
# Test Secret Key: uses Stripe test card 4242 4242 4242 4242 (Success) or 4000 0000 0000 0002 (Decline)
STRIPE_SECRET_KEY="sk_test_51MockStripeKeyFieldOpsTechnicalServicesLLCDubai2026"
STRIPE_WEBHOOK_SECRET="whsec_test_mock_webhook_secret_fieldops_2026"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_51MockStripePublishableKeyFieldOps2026"

# ------------------------------------------------------------------------------
# 5. STORAGE & DOCUMENT VAULT (APPWRITE CLOUD)
# ------------------------------------------------------------------------------
# Appwrite Cloud Endpoint (Region: Singapore 'sgp')
APPWRITE_ENDPOINT="https://sgp.cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID="6ab39ac100341b093fed"
APPWRITE_API_KEY="your-appwrite-server-api-key-here"
APPWRITE_BUCKET_ID="fixngo-vault"

# ------------------------------------------------------------------------------
# 6. FRONTEND NEXT.JS WEB CLIENT
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="http://localhost:4000"

# ------------------------------------------------------------------------------
# 7. GOOGLE GEN AI (GEMINI) OPERATIONS ASSISTANT
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.6-flash"

