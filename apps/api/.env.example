# ==============================================================================
# FIXnGO API (NestJS 10) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Port for the NestJS API server (Render automatically provides PORT in production)
PORT=4000

# Application environment: 'development' | 'production' | 'test'
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. NEON POSTGRESQL + POSTGIS DATABASE ENGINE
# ------------------------------------------------------------------------------
# Pooled connection string used at runtime (via PgBouncer on port 6543)
# Neon connection format: postgresql://[user]:[password]@[endpoint]-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/fieldops_db?schema=public"

# Direct connection string used for Prisma migrations and schema push (port 5432)
# In local development, DIRECT_URL matches DATABASE_URL
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/fieldops_db?schema=public"

# ------------------------------------------------------------------------------
# 3. UPSTASH REDIS & BULLMQ BACKGROUND QUEUE
# ------------------------------------------------------------------------------
# Redis connection URL. For Upstash, use TLS scheme 'rediss://'
# Upstash format: rediss://default:[password]@[endpoint].upstash.io:6379
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 4. JWT AUTHENTICATION & SECURITY TOKENS
# ------------------------------------------------------------------------------
# High-entropy secret key for signing short-lived access JWT tokens
JWT_SECRET="fixngo-super-secret-jwt-signing-key-for-local-development-min-32-chars"

# Secret key for signing long-lived session refresh JWT tokens
JWT_REFRESH_SECRET="fixngo-super-secret-refresh-key-for-local-development-min-32-chars"

# Access token lifespan (e.g. 15m, 1h, 1d)
JWT_EXPIRES_IN="1d"

# Refresh token lifespan (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 5. CROSS-ORIGIN RESOURCE SHARING (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (Vercel preview branches automatically match)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://fixngo.vercel.app"

# ------------------------------------------------------------------------------
# 6. APPWRITE CLOUD STORAGE VAULT (SINGLE BUCKET)
# ------------------------------------------------------------------------------
# Appwrite Cloud REST endpoint (Singapore 'sgp' region recommended for Middle East latency)
APPWRITE_ENDPOINT="https://sgp.cloud.appwrite.io/v1"

# Appwrite project identifier from Cloud Console
APPWRITE_PROJECT_ID="6ab39ac100341b093fed"

# Server-scoped API Key with files.read and files.write permissions
APPWRITE_API_KEY="standard_your_appwrite_server_secret_key_here"

# Single storage bucket ID for all files (paths prefixed with jobs/, invoices/, documents/, avatars/)
APPWRITE_BUCKET_ID="fixngo-vault"

# ------------------------------------------------------------------------------
# 7. BILLING & PAYMENT GATEWAYS (STRIPE & OFFLINE MOCK)
# ------------------------------------------------------------------------------
# Payment provider engine: 'stripe' | 'mock'
PAYMENT_PROVIDER="mock"

# Stripe Secret API Key (use 'sk_test_...' for staging/testing)
STRIPE_SECRET_KEY="sk_test_placeholder_key_for_testing"

# Stripe Webhook Endpoint Secret (from Stripe CLI or Dashboard)
STRIPE_WEBHOOK_SECRET="whsec_placeholder_secret_for_testing"

# ------------------------------------------------------------------------------
# 8. GOOGLE GEN AI (GEMINI) OPERATIONS ASSISTANT
# ------------------------------------------------------------------------------
# Google Gen AI Studio API Key for "Ask FIXnGO" assistant
GEMINI_API_KEY="AIzaSyPlaceholderGeminiKeyForLocalDevelopment"

# Active Gemini Flash model name
GEMINI_MODEL="gemini-3.6-flash"
