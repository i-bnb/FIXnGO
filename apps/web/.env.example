# ==============================================================================
# FIXnGO WEB FRONTEND (Next.js 14 App Router) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND REST API URL
# ------------------------------------------------------------------------------
# Publicly accessible URL of the NestJS backend API.
# In local development: http://localhost:4000
# In production (Render): https://fixngo-api.onrender.com (No localhost fallback permitted)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ------------------------------------------------------------------------------
# 2. REALTIME SOCKET.IO SERVER URL
# ------------------------------------------------------------------------------
# Publicly accessible URL for WebSocket telematics and live fleet dispatch.
# In local development: http://localhost:4000
# In production (Render): https://fixngo-api.onrender.com
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# ------------------------------------------------------------------------------
# 3. STRIPE CLIENT PUBLISHABLE KEY
# ------------------------------------------------------------------------------
# Stripe Publishable Key for client-side Elements checkout (test mode: pk_test_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder_key_for_client_elements"
